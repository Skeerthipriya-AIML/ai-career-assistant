# Database (Leave blank to automatically use In-Memory fallback or provide MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/ai_career_assistant
CHROMA_DB_PATH=./chroma_db

# Security & Secrets
JWT_SECRET=supersecretproductionjwtkey123
ENVIRONMENT=production

# AI / Inference
HUGGINGFACEHUB_API_TOKEN=your_huggingface_hub_api_token_here

# CORS / Deployment Allowed Origins (e.g. your Vercel URL)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5175
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app|https://.*\.netlify\.app

# OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GITHUB_CLIENT_ID=your_github_client_id
